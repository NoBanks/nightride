# Put keys in ~/.nightride/.env (outside the repo and any synced folder).
# A local .env here also works and is gitignored. The browser never sees these.
PORT=8787
# Baseten key for Muse Spark Open (open weights).
BASETEN_API_KEY=
# SPARK=off answers from canned data even with a key set (saves credit while building).
SPARK=
# Meta Model API key. Leave empty until the hackathon credits show on Billing:
# without them every call bills the card on file.
MODEL_API_KEY=
